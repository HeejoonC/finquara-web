# =============================================
# Finquara 환경변수 예시
# 이 파일을 .env.local 로 복사한 뒤 값을 채우세요. (.env* 는 git에 올라가지 않습니다)
# =============================================

# ── Supabase ─────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOi...

# AI 자동 수집이 RLS를 우회해 jobs/job_imports 에 직접 쓰기 위해 필요합니다.
# Supabase Dashboard → Project Settings → API → service_role key
# ⚠️ 절대 클라이언트 코드나 공개 저장소에 노출하지 마세요.
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...

# ── AI 채용공고 수집 ─────────────────────────
# [웹 관리자 페이지 /admin/ai-import] OpenRouter + DeepSeek
# https://openrouter.ai/keys 에서 발급
OPENROUTER_API_KEY=sk-or-v1-...

# 사용할 모델 (선택). 미지정 시 deepseek/deepseek-v3.2
# 더 저렴하게: deepseek/deepseek-v4-flash
OPENROUTER_MODEL=deepseek/deepseek-v3.2

# [로컬 스크립트 npm run scrape] Claude Code 구독 토큰을 사용하므로
# 별도 API 키가 필요 없습니다. 터미널에서 `claude` 실행 후 /login 만 하면 됩니다.

# ── 기타 ─────────────────────────────────────
NEXT_PUBLIC_SITE_URL=http://localhost:3000
